DATABASE_URL=postgresql://user:password@localhost:5432/bioinfood
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-refresh
PORT=3001
# comma-separated list of allowed origins; on Railway set to the deployed web URL
CORS_ORIGINS=http://localhost:3000

# Senhas dos usuários do seed. Opcionais contra um banco local (caem em
# admin123/lider123/cliente123); OBRIGATÓRIAS contra um banco remoto, senão o
# seed aborta. Mínimo 8 caracteres.
# SEED_ADMIN_PASSWORD=
# SEED_LIDER_PASSWORD=
# SEED_CLIENTE_PASSWORD=
