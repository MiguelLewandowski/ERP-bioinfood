// ============================================================================
//  ERP — Schema Prisma unificado
//  Projetos (existente) + Núcleo de Organizações + CRM + Ganchos de módulos
//
//  Dívidas corrigidas nesta versão:
//   1. Project.clientName (String)   -> Project.clientId  (FK -> Organization)
//   2. Project.sponsor / Charter.team / Charter.stakeholders (String)
//                                    -> ProjectStakeholder (join real, tipado)
//   3. Charter.projectOwner (String) -> Charter.projectOwnerId (FK -> Contact)
//   4. Charter.approvedById (solto)  -> relação real approvedBy (-> User)
//   5. User.role: identidade do cliente liga a Contact via User.contactId;
//                                       SystemRole.CLIENTE = só permissão de portal.
//   6. Ganchos LIMS / Estoque / Compras agora apontam para Organization.id
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── ENUMS ─────────────────────────────────────

// -- Segurança / permissão (SÓ sobre o que o login pode fazer) --
enum SystemRole {
  ADMIN // gestão total, inclusive usuários, CRM e exclusão definitiva.
  PADRAO // interno: vê e edita todos os projetos. Sem tela de usuários, sem CRM, exclusão só reversível (soft delete).
  CLIENTE // login externo restrito (portal do cliente). Vê só projetos liberados via ProjectAccess.
}

// -- Projetos (existentes) --
enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// PMBOK: FS (Finish-to-Start), SS (Start-to-Start), FF (Finish-to-Finish), SF (Start-to-Finish).
enum TaskDependencyType {
  FS
  SS
  FF
  SF
}

enum RiskProbability {
  VERY_LOW
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum RiskImpact {
  VERY_LOW
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

// -- Partes interessadas do projeto (substitui team/stakeholders/sponsor texto) --
enum StakeholderType {
  SPONSOR
  OWNER
  TEAM_MEMBER
  STAKEHOLDER
}

// -- Núcleo de Organizações (dados mestres) --
enum PartyType {
  COMPANY // pessoa jurídica
  PERSON // pessoa física
}

enum DocumentType {
  CNPJ
  CPF
  FOREIGN
  OTHER
}

enum RegistrationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  CLOSED
  VOID
  UNKNOWN
}

// Higiene de registro (este cadastro ainda importa?). A semântica COMERCIAL
// do relacionamento (prospect/ativo/VIP/inativo) mora em CustomerProfile.stage.
enum OrganizationStatus {
  ACTIVE
  ARCHIVED
}

enum PartyRoleType {
  CUSTOMER
  SUPPLIER
  CARRIER
  PARTNER
  FUNDING_AGENCY // agência de fomento (FINEP, FAPESP...)
  RESEARCH_INSTITUTION // ICT
}

enum PartyRoleStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum AddressType {
  PRIMARY
  BILLING
  SHIPPING
  COLLECTION
}

enum CustomerStage {
  PROSPECT
  ACTIVE
  INACTIVE
  VIP
}

// -- CRM (interações / atividades / funil) --
enum InteractionType {
  EMAIL
  CALL
  MEETING
  VISIT
  WHATSAPP
  OTHER
}

enum InteractionDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum ActivityStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

// Semântica fixa das etapas do funil (§2.4 do modulo_CRM.md): o rótulo da
// etapa é DADO (PipelineStage.name, livre); o que o código entende é o type.
enum StageType {
  OPEN
  WON
  LOST
}

// Tipo de tarefa/registro de contato (unifica o antigo conceito de Interaction
// dentro de Activity — §crm-redesign-2026-07).
enum ActivityType {
  NOTE
  EMAIL
  CALL
  WHATSAPP
  PROPOSAL
  MEETING
  VISIT
  OTHER
}

// -- Estoque / Compras (stub) --
enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

// ═══════════════════════════ IDENTIDADE / AUTH ═════════════════════════════

model User {
  id                 String     @id @default(cuid())
  name               String
  email              String     @unique
  passwordHash       String
  role               SystemRole @default(PADRAO)
  isActive           Boolean    @default(true)
  mustChangePassword Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  // Liga a IDENTIDADE (login) à PESSOA DE NEGÓCIO. Nulo p/ contas internas puras.
  contactId String?  @unique
  contact   Contact? @relation(fields: [contactId], references: [id])

  // Relações de projetos (existentes)
  createdProjects   Project[]        @relation("CreatedBy")
  baselinedProjects Project[]        @relation("BaselineSetBy")
  receivedAccesses  ProjectAccess[]  @relation("ReceivedAccess")
  grantedAccesses   ProjectAccess[]  @relation("GrantedAccess")
  assignedTasks     Task[]           @relation("TaskAssignee")
  ownedRisks        Risk[]           @relation("RiskOwner")
  coAssignedTasks   TaskCoAssignee[] @relation("TaskCoAssignee")
  coOwnedRisks      RiskCoOwner[]    @relation("RiskCoOwner")
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]

  // Novas relações (deixam de ser texto/solto)
  approvedCharters         Charter[]
  charterTeamMemberships   CharterTeamMember[] @relation("CharterTeamMember")
  salesCustomerProfiles    CustomerProfile[]
  loggedInteractions       Interaction[]
  responsibleActivities    Activity[]
  responsibleOpportunities Opportunity[]
  authoredPopVersions      PopVersion[]        @relation("PopVersionAuthor")
  addedTaskPops            TaskPop[]           @relation("TaskPopAddedBy")
  notes                    Note[]              @relation("NoteOwner")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  jti       String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jti])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ═══════════════════ DADOS MESTRES: ORGANIZAÇÃO (a espinha) ════════════════

model Organization {
  id                 String             @id @default(cuid())
  partyType          PartyType          @default(COMPANY)
  legalName          String // razão social
  tradeName          String? // nome fantasia
  document           String?            @unique // CNPJ/CPF — SÓ dígitos (normalizar na aplicação)
  documentType       DocumentType?
  stateRegistration  String?
  cityRegistration   String?
  cnae               String?
  registrationStatus RegistrationStatus @default(UNKNOWN)
  status             OrganizationStatus @default(ACTIVE)
  website            String?
  notes              String?

  // Contato direto da organização (paridade com o CRM anterior — Agendor)
  email     String?
  phone     String?
  mobile    String?
  whatsapp  String?
  fax       String?
  ramal     String?
  facebook  String?
  twitter   String?
  linkedin  String?
  skype     String?
  instagram String?

  // Taxonomias configuráveis (rótulo é dado, não texto livre — §2.4)
  sectorId   String?
  sector     Sector?             @relation(fields: [sectorId], references: [id])
  sourceId   String?
  source     OrganizationSource? @relation(fields: [sourceId], references: [id])
  categoryId String?
  category   Category?           @relation(fields: [categoryId], references: [id])

  productServices OrganizationProductService[]

  // Hierarquia matriz → filiais
  parentId String?
  parent   Organization?  @relation("OrgHierarchy", fields: [parentId], references: [id])
  branches Organization[] @relation("OrgHierarchy")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Papéis e perfis
  roles           PartyRole[]
  customerProfile CustomerProfile?
  supplierProfile SupplierProfile?

  // Estrutura compartilhada
  addresses    Address[]
  contactLinks ContactOrganizationLink[]

  // CRM
  interactions  Interaction[]
  activities    Activity[]
  opportunities Opportunity[]

  // Ganchos de módulos (agora FK, não texto)
  projects       Project[] // projetos onde é o cliente
  labOrders      LabOrder[] // ordens LIMS (como cliente)
  purchaseOrders PurchaseOrder[] // pedidos de compra (como fornecedor)

  @@index([document])
  @@index([status])
  @@index([parentId])
  @@index([deletedAt])
}

model Address {
  id           String       @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  type         AddressType  @default(PRIMARY)
  isPrimary    Boolean      @default(false)
  street       String?
  number       String?
  complement   String?
  district     String?
  city         String?
  state        String?      @db.Char(2)
  zipCode      String?
  country      String       @default("Brasil")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([orgId])
}

model PartyRole {
  id           String          @id @default(cuid())
  orgId        String
  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  type         PartyRoleType
  status       PartyRoleStatus @default(ACTIVE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([orgId, type]) // uma org não repete o mesmo papel
  @@index([type])
}

model CustomerProfile {
  orgId        String        @id
  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stage        CustomerStage @default(PROSPECT)
  paymentTerms String?
  creditLimit  Decimal?      @db.Decimal(15, 2)
  salesRepId   String?
  salesRep     User?         @relation(fields: [salesRepId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model SupplierProfile {
  orgId        String       @id
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category     String?
  paymentTerms String?
  leadTimeDays Int?
  approved     Boolean      @default(false)
  rating       Int? // 1..5 (validar na aplicação)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// ═══════════════════ DADOS MESTRES: CONTATOS (pessoas) ═════════════════════

model Contact {
  id        String              @id @default(cuid())
  name      String
  cpf       String? // só dígitos (normalizar na aplicação)
  email     String?
  phone     String?
  mobile    String?
  whatsapp  String?
  fax       String?
  ramal     String?
  birthDate DateTime? // aniversário
  facebook  String?
  twitter   String?
  linkedin  String?
  skype     String?
  instagram String?
  notes     String?
  sourceId  String? // origem da pessoa (reaproveita a taxonomia de OrganizationSource)
  source    OrganizationSource? @relation(fields: [sourceId], references: [id])
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  deletedAt DateTime?

  user User? // identidade de login opcional (back-relation de User.contactId)

  orgLinks      ContactOrganizationLink[]
  interactions  Interaction[]
  activities    Activity[]
  opportunities Opportunity[]
  ownedCharters Charter[] // projetos onde é o dono (projectOwner)
  stakeholderIn ProjectStakeholder[]
  labOrders     LabOrder[] // ordens LIMS solicitadas

  @@index([email])
}

model ContactOrganizationLink {
  id           String       @id @default(cuid())
  contactId    String
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  jobTitle     String?
  department   String?
  isDecision   Boolean      @default(false)
  isFinance    Boolean      @default(false)
  isTechnical  Boolean      @default(false)
  isPrimary    Boolean      @default(false)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([contactId, orgId])
  @@index([orgId])
}

// ═══════════════════════════════ CRM ══════════════════════════════════════

model Interaction {
  id            String               @id @default(cuid())
  orgId         String
  organization  Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       Contact?             @relation(fields: [contactId], references: [id])
  userId        String?
  user          User?                @relation(fields: [userId], references: [id])
  type          InteractionType
  direction     InteractionDirection @default(OUTBOUND)
  subject       String?
  summary       String? // 3 linhas — alvo natural p/ IA depois
  fullContent   String? // e-mail/transcrição na íntegra
  interactionAt DateTime             @default(now())
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deletedAt     DateTime?

  activities Activity[]

  @@index([orgId, interactionAt])
  @@index([contactId])
}

model Activity {
  id            String         @id @default(cuid())
  orgId         String?
  organization  Organization?  @relation(fields: [orgId], references: [id])
  contactId     String?
  contact       Contact?       @relation(fields: [contactId], references: [id])
  interactionId String?
  interaction   Interaction?   @relation(fields: [interactionId], references: [id])
  opportunityId String?
  opportunity   Opportunity?   @relation(fields: [opportunityId], references: [id])
  responsibleId String?
  responsible   User?          @relation(fields: [responsibleId], references: [id])
  // Opcional: a tarefa do CRM se identifica pelo `type` (badge WhatsApp/Reunião/
  // E-mail...), não por um título livre.
  title         String?
  description   String?
  type          ActivityType   @default(NOTE)
  priority      TaskPriority   @default(MEDIUM)
  status        ActivityStatus @default(PENDING)
  dueDate       DateTime?
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([orgId])
  @@index([opportunityId])
  @@index([status, dueDate])
}

// ── Taxonomias configuráveis (admin gerencia sem deploy — §3.6) ────────────
// isActive aposenta um valor sem apagar o histórico que o referencia.

model Sector {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizations Organization[]
}

model OrganizationSource {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizations Organization[]
  contacts      Contact[] // reaproveitada como "origem" da pessoa
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizations Organization[]
}

model ProductService {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationLinks OrganizationProductService[]
}

// Empresa <-> produtos/serviços de interesse (M:N — §crm-redesign-2026-07, decisão 2).
model OrganizationProductService {
  id               String         @id @default(cuid())
  orgId            String
  organization     Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  productServiceId String
  productService   ProductService @relation(fields: [productServiceId], references: [id])
  createdAt        DateTime       @default(now())

  @@unique([orgId, productServiceId])
  @@index([orgId])
  @@index([productServiceId])
}

// Escada de maturidade de P&D (Lab → Piloto → Escala) — global, não por
// pipeline (decisão de projeto: YAGNI até existir caso de uso real).
model EngagementStage {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunities Opportunity[]
}

// ── Funil configurável (§2.5): um Pipeline por linha de negócio ────────────

model Pipeline {
  id           String    @id @default(cuid())
  name         String
  abbreviation String    @default("") // 3 letras maiúsculas p/ o rail de troca de funil no kanban
  isDefault    Boolean   @default(false)
  isActive     Boolean   @default(true)
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  stages        PipelineStage[]
  opportunities Opportunity[]

  @@index([deletedAt])
}

model PipelineStage {
  id          String    @id @default(cuid())
  pipelineId  String
  pipeline    Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name        String // rótulo livre do usuário ("Piloto", "Due diligence"...)
  type        StageType @default(OPEN) // semântica fixa que o código entende
  probability Int       @default(0) // 0..100 — default aplicado ao mover o card
  color       String?
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  opportunities Opportunity[]

  @@index([pipelineId])
}

model Opportunity {
  id            String       @id @default(cuid())
  orgId         String
  organization  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  mainContactId String?
  mainContact   Contact?     @relation(fields: [mainContactId], references: [id])
  responsibleId String?
  responsible   User?        @relation(fields: [responsibleId], references: [id])

  // Funil: etapa relacional (rótulo configurável) no lugar do antigo enum.
  pipelineId String
  pipeline   Pipeline      @relation(fields: [pipelineId], references: [id])
  stageId    String
  stage      PipelineStage @relation(fields: [stageId], references: [id])

  engagementStageId String?
  engagementStage   EngagementStage? @relation(fields: [engagementStageId], references: [id])

  title             String
  amount            Decimal?  @db.Decimal(15, 2)
  currency          String    @default("BRL")
  probability       Int? // 0..100 — sobrescrito pelo default da etapa ao mover; editável
  startDate         DateTime?
  description       String?
  // Dia de calendário: o CRM só escreve por <input type="date"> e lê com
  // slice(0,10). @db.Date impede que alguém volte a gravar um instante aqui.
  expectedCloseDate DateTime? @db.Date
  closedAt          DateTime? // preenchido ao entrar em etapa WON/LOST
  lostReason        String?
  // Congelado é um marcador ortogonal à etapa do funil (não é WON/LOST/OPEN):
  // negócio pausado que some do funil ativo mas pode ser reativado depois.
  frozenAt          DateTime?
  // Posição manual do card dentro da coluna/etapa no kanban (drag reorder).
  order             Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  activities Activity[]

  @@index([orgId])
  @@index([pipelineId, stageId])
  @@index([stageId, order])
  @@index([deletedAt])
}

// ═══════════════════════════ PROJETOS ═════════════════════════════════════

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  // Dia de calendário — início e término planejados do projeto não têm hora.
  startDate   DateTime?     @db.Date
  endDate     DateTime?     @db.Date
  objective   String?

  // DÍVIDA CORRIGIDA: clientName (String) -> FK para Organization.
  clientId String?
  client   Organization? @relation(fields: [clientId], references: [id])

  createdById     String
  // Linha de base do cronograma (PMBOK): quando/por quem foi aprovada.
  baselineSetAt   DateTime?
  baselineSetById String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  createdBy     User  @relation("CreatedBy", fields: [createdById], references: [id])
  baselineSetBy User? @relation("BaselineSetBy", fields: [baselineSetById], references: [id])

  accesses     ProjectAccess[]
  charter      Charter?
  wbsNodes     WbsNode[]
  tasks        Task[]
  risks        Risk[]
  milestones   Milestone[]
  stakeholders ProjectStakeholder[] // substitui sponsor/team/stakeholders texto
  labOrders    LabOrder[] // LIMS ligado ao projeto (opcional)

  @@index([status])
  @@index([createdById])
  @@index([clientId])
  @@index([deletedAt])
}

model ProjectAccess {
  id          String   @id @default(cuid())
  projectId   String
  userId      String
  grantedById String?
  grantedAt   DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation("ReceivedAccess", fields: [userId], references: [id])
  grantedBy User?   @relation("GrantedAccess", fields: [grantedById], references: [id])

  @@unique([projectId, userId])
}

// Registro de partes interessadas (PMBOK). Substitui os campos texto
// Charter.team, Charter.stakeholders e Project.sponsor por relações reais.
model ProjectStakeholder {
  id        String          @id @default(cuid())
  projectId String
  contactId String
  type      StakeholderType @default(STAKEHOLDER)
  roleNote  String? // papel específico no projeto (texto livre)
  influence RiskImpact? // reaproveita a escala VERY_LOW..VERY_HIGH
  interest  RiskImpact?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id])

  @@unique([projectId, contactId, type])
  @@index([projectId])
  @@index([contactId])
}

model Charter {
  id        String @id @default(cuid())
  projectId String @unique

  // Section 1 — Identificação
  projectType String?
  priority    String?

  // DÍVIDA CORRIGIDA: projectOwner (String) -> FK para Contact
  projectOwnerId String?
  projectOwner   Contact? @relation(fields: [projectOwnerId], references: [id])
  // team/stakeholders removidos -> ver ProjectStakeholder

  // Section 2 — Contexto (narrativa: permanece texto)
  problem       String?
  justification String?
  assumptions   String?

  // Section 3 — Objetivos
  mainObjective      String?
  specificObjectives String?
  kpis               String?

  // Section 4 — Escopo
  scope      String?
  outOfScope String?

  // Section 5 — Entregáveis
  deliverables String?

  // Section 6 — Recursos (antes: campo único `resources`, texto livre)
  infrastructure String?
  budget         Decimal?            @db.Decimal(14, 2)
  team           CharterTeamMember[]
  // Checklist de equipamentos/insumos, puxada do cadastro de estoque.
  equipment      CharterEquipment[]

  // Section 7 — Governança (narrativa)
  governance String?

  // Section 8 — Dependências
  dependencies String?

  // Constraints e aprovação
  constraints String?

  // DÍVIDA CORRIGIDA: approvedById solto -> relação real com User
  approvedById String?
  approvedBy   User?     @relation(fields: [approvedById], references: [id])
  approvedAt   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectOwnerId])
  @@index([approvedById])
}

// Equipe do TAP (Section 6 — Recursos): múltiplos responsáveis, join real com User.
model CharterTeamMember {
  id        String   @id @default(cuid())
  charterId String
  userId    String
  createdAt DateTime @default(now())

  charter Charter @relation(fields: [charterId], references: [id], onDelete: Cascade)
  user    User    @relation("CharterTeamMember", fields: [userId], references: [id])

  @@unique([charterId, userId])
  @@index([charterId])
  @@index([userId])
}

model WbsNode {
  id            String    @id @default(cuid())
  projectId     String
  parentId      String?
  code          String
  title         String
  owner         String?
  readyCriteria String?
  outputs       String?
  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   WbsNode?  @relation("WbsTree", fields: [parentId], references: [id])
  children WbsNode[] @relation("WbsTree")
  tasks    Task[]

  @@index([projectId])
  @@index([parentId])
}

model Task {
  id            String       @id @default(cuid())
  projectId     String
  wbsNodeId     String?
  assigneeId    String?
  title         String
  description   String?
  status        TaskStatus   @default(TODO)
  priority      TaskPriority @default(MEDIUM)
  storyPoints   Int?
  // Se a tarefa exige POP. Default `true` preserva o denominador da métrica de
  // cobertura no dia do deploy — o número só muda quando alguém classificar uma
  // tarefa como administrativa. Ver docs/planejamento-ui-projetos.md, Onda 5.
  requiresSOP   Boolean      @default(true)
  // Subtarefa: tarefa-pai (hierarquia de atividades no Gantt).
  parentId      String?
  startDate     DateTime?
  dueDate       DateTime?
  // Linha de base (planejado aprovado) — snapshot de startDate/dueDate.
  baselineStart DateTime?
  baselineEnd   DateTime?
  // Datas reais de execução (preenchidas na mudança de status).
  actualStart   DateTime?
  actualEnd     DateTime?
  order         Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode      WbsNode?            @relation(fields: [wbsNodeId], references: [id])
  assignee     User?               @relation("TaskAssignee", fields: [assigneeId], references: [id])
  parent       Task?               @relation("TaskSubtasks", fields: [parentId], references: [id])
  subtasks     Task[]              @relation("TaskSubtasks")
  coAssignees  TaskCoAssignee[]
  successors   TaskDependency[]    @relation("Predecessor")
  predecessors TaskDependency[]    @relation("Successor")
  checklist    TaskChecklistItem[]
  pops         TaskPop[]

  @@index([projectId])
  @@index([status])
  @@index([assigneeId])
  @@index([wbsNodeId])
  @@index([parentId])
  @@index([deletedAt])
}

/// Corresponsáveis por uma tarefa, além do `Task.assigneeId`.
///
/// Mesmo desenho de [RiskCoOwner]: `assigneeId` continua sendo o responsável
/// PRINCIPAL, e esta tabela guarda quem divide o trabalho. Mover todo mundo
/// para a N:N obrigaria a reescrever kanban, backlog, Gantt, Atividades,
/// filtros de "minhas tarefas" e o contrato de `packages/shared` de uma vez —
/// e a quebrar o `assigneeId` que já está em produção.
model TaskCoAssignee {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation("TaskCoAssignee", fields: [userId], references: [id])

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

model TaskChecklistItem {
  id        String   @id @default(cuid())
  taskId    String
  text      String
  checked   Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskDependency {
  id            String             @id @default(cuid())
  predecessorId String
  successorId   String
  type          TaskDependencyType @default(FS)
  lag           Int                @default(0)
  createdAt     DateTime           @default(now())

  predecessor Task @relation("Predecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   Task @relation("Successor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@index([predecessorId])
  @@index([successorId])
}

model Risk {
  id          String          @id @default(cuid())
  projectId   String
  ownerId     String?
  title       String
  description String?
  probability RiskProbability @default(MEDIUM)
  impact      RiskImpact      @default(MEDIUM)
  score       Int
  response    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner    User?         @relation("RiskOwner", fields: [ownerId], references: [id])
  coOwners RiskCoOwner[]

  @@index([projectId])
  @@index([score])
  @@index([deletedAt])
}

/// Corresponsáveis por um risco, além do `Risk.ownerId`.
///
/// `ownerId` continua sendo o responsável PRINCIPAL — quem responde numa
/// escalada — e esta tabela guarda quem divide a responsabilidade. Modelar
/// assim (em vez de mover todo mundo para a N:N) mantém a mudança aditiva: nada
/// precisa de backfill, o contrato da API não quebra, e as telas que leem
/// `owner` no singular seguem funcionando enquanto migram.
model RiskCoOwner {
  id        String   @id @default(cuid())
  riskId    String
  userId    String
  createdAt DateTime @default(now())

  risk Risk @relation(fields: [riskId], references: [id], onDelete: Cascade)
  user User @relation("RiskCoOwner", fields: [userId], references: [id])

  @@unique([riskId, userId])
  @@index([riskId])
  @@index([userId])
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?
  // Dia de calendário — marco acontece num dia, não num instante.
  date        DateTime  @db.Date
  reached     Boolean   @default(false)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([date])
}

// ═══════════════════════════════ POPs ═════════════════════════════════════
// Procedimento Operacional Padrão — versionável, GLOBAL (docs/regras-negocio/pop.md).
// Pop é a identidade (título estável, catálogo único do ERP — sem projeto);
// PopVersion é a revisão imutável de conteúdo (nunca editada após criada);
// TaskPop registra qual VERSÃO exata foi usada em qual task de qual projeto
// (o vínculo de uso é project-scoped via Task, não a Pop em si).

// Taxonomia de POPs — mesma forma das taxonomias do CRM (Sector, Category...).
// Vive fora do CRM porque a tela de POPs é acessível ao papel PADRAO.
model PopCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pops Pop[]
}

model Pop {
  id          String    @id @default(cuid())
  title       String
  description String?
  // Toda POP pertence a uma categoria. Excluir categoria em uso é bloqueado
  // (Restrict) — desativar em vez de excluir, como nas taxonomias do CRM.
  categoryId  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  category PopCategory  @relation(fields: [categoryId], references: [id])
  versions PopVersion[]

  @@index([categoryId])
  @@index([deletedAt])
}

model PopVersion {
  id            String   @id @default(cuid())
  popId         String
  versionNumber Int
  changeNotes   String?
  // Link do documento desta versão (Drive, SharePoint...). Quando o upload de
  // PDF para o Supabase entrar, o arquivo enviado grava a URL pública aqui.
  fileUrl       String?
  createdById   String
  createdAt     DateTime @default(now())

  pop        Pop       @relation(fields: [popId], references: [id], onDelete: Cascade)
  createdBy  User      @relation("PopVersionAuthor", fields: [createdById], references: [id])
  taskUsages TaskPop[]

  @@unique([popId, versionNumber])
  @@index([popId])
}

model TaskPop {
  id           String   @id @default(cuid())
  taskId       String
  popVersionId String
  addedById    String
  createdAt    DateTime @default(now())

  task       Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  popVersion PopVersion @relation(fields: [popVersionId], references: [id])
  addedBy    User       @relation("TaskPopAddedBy", fields: [addedById], references: [id])

  @@unique([taskId, popVersionId])
  @@index([taskId])
  @@index([popVersionId])
}

// ══════════════ GANCHOS DE MÓDULOS (stubs — detalhar depois) ═══════════════
//  Existem só para fixar as FKs para os dados mestres. Cada módulo será
//  desenvolvido no futuro; o núcleo já os referencia hoje.

// -- LIMS --
model LabOrder {
  id           String       @id @default(cuid())
  number       String       @unique
  orgId        String // organização cliente
  organization Organization @relation(fields: [orgId], references: [id])
  requesterId  String? // contato que solicitou
  requester    Contact?     @relation(fields: [requesterId], references: [id])
  projectId    String? // opcional: ligado a um projeto
  project      Project?     @relation(fields: [projectId], references: [id])
  status       String       @default("RECEIVED")
  receivedAt   DateTime     @default(now())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  samples LabSample[]

  @@index([orgId])
  @@index([projectId])
}

model LabSample {
  id         String   @id @default(cuid())
  labOrderId String
  labOrder   LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  identifier String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([labOrderId])
}

// -- Compras / Estoque --
model Product {
  id          String    @id @default(cuid())
  sku         String    @unique
  name        String
  description String?
  unit        String? // UN, KG, L...
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  purchaseItems  PurchaseOrderItem[]
  stockMovements StockMovement[]
}

model PurchaseOrder {
  id          String       @id @default(cuid())
  number      String       @unique
  supplierId  String // organização fornecedora
  supplier    Organization @relation(fields: [supplierId], references: [id])
  status      String       @default("OPEN")
  totalAmount Decimal?     @db.Decimal(15, 2)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  items PurchaseOrderItem[]

  @@index([supplierId])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Decimal       @db.Decimal(15, 3)
  unitPrice       Decimal       @db.Decimal(15, 2)

  @@index([purchaseOrderId])
  @@index([productId])
}

model StockMovement {
  id        String            @id @default(cuid())
  productId String
  product   Product           @relation(fields: [productId], references: [id])
  type      StockMovementType
  quantity  Decimal           @db.Decimal(15, 3)
  reference String? // origem: pedido, ajuste, consumo LIMS...
  createdAt DateTime          @default(now())

  @@index([productId])
  @@index([createdAt])
}

// ═════════════════════════ ESTOQUE (cadastro de itens) ═════════════════════
//
// Cadastro do que a Bioinfood TEM e usa nos projetos — equipamentos hoje,
// insumos/vidraria quando alguém cadastrar a categoria. Deliberadamente básico:
// não há movimentação, saldo, reserva nem agenda de uso. O projeto declara o que
// precisa (CharterEquipment) e marca o que já está providenciado; alocação com
// janela de tempo é outro problema, e traria conflito entre projetos junto.
//
// NÃO confundir com o stub `Product`/`StockMovement`/`PurchaseOrder` acima:
// aquilo é compras e movimentação, nunca teve módulo nem tela nem dado, e
// segue intocado. Reaproveitar `Product` (consumível, com saldo) para
// equipamento durável distorceria os dois conceitos.

model StockCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items StockItem[]
}

model StockItem {
  id         String  @id @default(cuid())
  name       String
  // Patrimônio/etiqueta. Opcional: nem todo item tem, mas quando tem é único.
  code       String? @unique
  categoryId String
  quantity   Int     @default(1)
  unit       String? // un, kg, L, mL...
  location   String? // "Lab 2 — bancada 3"
  // ACTIVE | MAINTENANCE | RETIRED — string como já é o padrão do projeto
  // (WbsNode.status, PurchaseOrder.status), sem enum novo no banco.
  status     String  @default("ACTIVE")
  notes      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  category     StockCategory      @relation(fields: [categoryId], references: [id])
  charterLinks CharterEquipment[]

  @@index([categoryId])
  @@index([deletedAt])
}

// Checklist de recursos do projeto (Seção 6 do TAP — Recursos e Orçamento).
// `checked` = "já providenciado"; desmarcado = ainda falta. Sem janela de uso.
model CharterEquipment {
  id          String   @id @default(cuid())
  charterId   String
  stockItemId String
  quantity    Int      @default(1)
  checked     Boolean  @default(false)
  createdAt   DateTime @default(now())

  charter   Charter   @relation(fields: [charterId], references: [id], onDelete: Cascade)
  stockItem StockItem @relation(fields: [stockItemId], references: [id])

  @@unique([charterId, stockItemId])
  @@index([charterId])
  @@index([stockItemId])
}

// ═══════════════════════ ANOTAÇÕES PESSOAIS (privadas) ═════════════════════
//
// ⚠️ ÚNICA exceção de privacidade do ERP: nota pessoal é do dono e de mais
// ninguém — **nem ADMIN lê**.
//
// A trava NÃO está no RolesGuard (que deixa ADMIN passar por design, e mexer
// nele afetaria todos os outros módulos). Está em não existir caminho: o
// `ownerId` nunca é parâmetro de entrada, vem sempre do JWT, e todo acesso do
// repositório filtra por ele. Não há endpoint que aceite ownerId, não há
// listagem global. ADMIN que chamar GET /notes recebe as notas DELE.
//
// Consequência para quem for mexer aqui depois: qualquer endpoint novo que
// aceite um ownerId de fora quebra a garantia inteira. Ver CLAUDE.md.
model Note {
  id          String  @id @default(cuid())
  ownerId     String
  title       String  @default("Sem título")
  contentHtml String? // texto rico — sanitizado na escrita
  pinned      Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner User @relation("NoteOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, updatedAt])
  @@index([deletedAt])
}
