{
  "name": "bioinfood-erp",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "seed": "pnpm --filter @bioinfood/api prisma:seed",
    "db:deploy": "pnpm --filter @bioinfood/api prisma:deploy",
    "db:reset-data": "pnpm --filter @bioinfood/api prisma:reset-data"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "pnpm": {
    "overrides": {
      "multer@<2.2.0": ">=2.2.0",
      "tar@<7.5.11": ">=7.5.11",
      "file-type@<21.3.2": ">=21.3.2",
      "postcss@<8.5.10": ">=8.5.10"
    }
  },
  "packageManager": "pnpm@9.0.0"
}
